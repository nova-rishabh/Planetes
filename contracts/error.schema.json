{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nova-rishabh/Planetes/contracts/error.schema.json",
  "title": "Error",
  "description": "Body of every HTTP 4xx/5xx response (docs/03 §3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "error"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "error": { "$ref": "#/$defs/ErrorBody" }
  },
  "$defs": {
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "hint"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["BAD_INPUT", "NOT_FOUND", "NO_COVERAGE", "IRSA_TIMEOUT", "IRSA_ERROR", "TOO_LARGE", "INTERNAL"]
        },
        "message": { "type": "string" },
        "hint": { "type": ["string", "null"] }
      }
    }
  }
}
